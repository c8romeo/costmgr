+  description: string;
+}
+
+const FEATURES: ReadonlyArray<FeatureCard> = [
+  {
+    key: "abc",
+    title: "ABC 엔진 (TDABC 통합)",
+    description: "활동기준원가 계산 + 시간동인 원가배분으로 정확한 원가 분석을 제공합니다.",
