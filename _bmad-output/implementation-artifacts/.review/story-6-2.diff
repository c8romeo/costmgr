+# ── TypedDict shapes ─────────────────────────────────────────
+class V4Failure(TypedDict):
+    """Per-product closing snapshot inconsistency (extension 6-1 → 6-2).
+
+    AD-15: snake_case field names. Mirrors TS `V4Failure` (future
+    Story 6-2 Monthly Closing Report wire).
