+V4_STATUS_FAILED: Final[str] = "failed"
+V4_STATUS_SKIPPED: Final[str] = "skipped"
+
+V4_STATUSES: Final[frozenset[str]] = frozenset(
+    {V4_STATUS_PASSED, V4_STATUS_FAILED, V4_STATUS_SKIPPED}
+)
+
