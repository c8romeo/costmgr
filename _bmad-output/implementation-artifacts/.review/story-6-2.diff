+)
+from packages.services.m4_inventory.monthly_closing_report import (
+    CURRENCY_PAIR_DISPLAY_KO_FORMAT,
+    MONTHLY_CLOSING_REPORT_EMPTY_KO,
+    MONTHLY_CLOSING_REPORT_TITLE_KO,
