+        alignItems: "center",
+        gap: "0.25rem",
+        padding: "0.125rem 0.5rem",
+        borderRadius: 9999,
+        border: `1px solid ${style.borderColor}`,
+        background: isActive ? style.background : "#f3f4f6",
+        color: isActive ? style.color : "#9ca3af",
+        fontSize: "0.75rem",
+        fontWeight: 600,
+        lineHeight: 1.4,
+        textDecoration: isActive ? "none" : "line-through",
+      }}
