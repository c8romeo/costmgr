+      {label}
+      {!isActive && (
+        <span
+          aria-hidden="true"
+          style={{
+            fontSize: "0.625rem",
+            fontWeight: 500,
+            marginLeft: "0.25rem",
+            color: "#9ca3af",
+          }}
+        >
+          (비활성)
+        </span>
+      )}
+    </span>
+  );
