+}
+
+function Td({
+  children,
+  align,
+}: {
+  children: React.ReactNode;
+  align?: "left" | "right" | "center";
+}) {
+  return (
+    <td
+      style={{
+        padding: "0.625rem 0.75rem",
+        textAlign: align ?? "left",
+        color: "#0f172a",
+        verticalAlign: "middle",
+      }}
+    >
+      {children}
+    </td>
+  );
+}
+
+function Chip({
+  active,
+  onClick,
+  label,
+  disabled,
+  tooltip,
