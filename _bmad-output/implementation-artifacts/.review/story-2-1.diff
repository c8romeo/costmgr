+                  <Td>{p.unit ?? "—"}</Td>
+                  <Td align="right">{p.unit_cost_krw ?? "—"}</Td>
+                  <Td align="right">{p.unit_cost_usd ?? "—"}</Td>
+                  <Td>
+                    {p.is_active ? (
+                      <span style={{ color: "#15803d", fontWeight: 600 }}>활성</span>
