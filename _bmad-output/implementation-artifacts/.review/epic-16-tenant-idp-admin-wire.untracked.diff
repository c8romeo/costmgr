+        acs_url = body.acs_url or f"https://{_placeholder_acs_host()}/api/v1/auth/sso/acs?tenant={tenant_slug}"
+
+    # Check for existing IdP (UNIQUE (tenant_id, idp_entity_id)).
+    existing = (
+        await session.execute(
