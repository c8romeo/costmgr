+    tenant_slug: str = Path(..., min_length=1, max_length=64),  # noqa: PT028
+    ctx: TenantContext = Depends(get_tenant_context),  # noqa: PT028
+    session: AsyncSession = Depends(get_session),  # noqa: PT028
