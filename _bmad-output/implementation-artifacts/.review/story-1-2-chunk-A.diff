@@ -0,0 +1,228 @@
+/**
+ * apps/web/components/settings/wizard/AllocationCriteriaStep.tsx
+ *
+ * Story 1.2 — Task 5.5. AC #3: 배부기준 3종 저장.
+ * Three sub-tabs (직접/간접 계정 분류 · 고정/변동 분류 · 동인 정의).
+ * Each shows the current count + a stub "추가" button that links to the
+ * M1 baseline / M9 ABC CRUD pages (Epic 2 / Epic 9 full impl).
+ *
+ * Industry-conditional drivers_required:
+ *   - manufacturing → drivers tab is hidden (A11 — no ABC engine).
+ *   - others → drivers required.
+ *
+ * PRD §3.A11 — CCR computation needs account tags.
+ */
+
+"use client";
+
+import { useState } from "react";
+
+import {
+  ApiError,
+  saveAllocationCriterion,
+  type AllocationCriterion,
+  type CompletionStatus,
+} from "@/lib/api-client";
+
+type TabKey = "direct_indirect" | "fixed_variable" | "drivers";
+
+interface TabSpec {
+  key: TabKey;
+  label: string;
+  description: string;
+  addHref: string;
+}
+
+const TABS: TabSpec[] = [
+  {
+    key: "direct_indirect",
+    label: "직접/간접 계정 분류",
+    description: "계정과목별로 직접원가/간접원가 분류를 등록하세요.",
+    addHref: "/dashboard/accounts",
+  },
+  {
+    key: "fixed_variable",
+    label: "고정/변동 분류",
+    description: "계정과목별로 고정비/변동비 분류를 등록하세요.",
+    addHref: "/dashboard/accounts",
+  },
+  {
+    key: "drivers",
+    label: "동인 정의",
+    description: "ABC 동인(실제적 조업능력 시간)을 등록하세요.",
+    addHref: "/dashboard/driver",
+  },
+];
+
+export interface AllocationCriteriaStepProps {
+  completion: CompletionStatus | null;
+  industry: string | null;
+  accessToken?: string;
+  onSaved: (next: CompletionStatus) => void;
+  onError: (msg: string) => void;
+}
+
+export function AllocationCriteriaStep({
+  completion,
+  industry,
+  accessToken,
+  onSaved,
+  onError,
+}: AllocationCriteriaStepProps) {
+  const driversRequired = completion?.drivers_required ?? industry !== "manufacturing";
+  const visibleTabs = TABS.filter((t) => t.key !== "drivers" || driversRequired);
+
+  const initialActive = visibleTabs[0]?.key ?? "direct_indirect";
+  const [active, setActive] = useState<TabKey>(initialActive as TabKey);
+  const [isSaving, setIsSaving] = useState(false);
+
+  function countFor(tab: TabKey): number {
+    if (!completion) return 0;
+    if (tab === "direct_indirect") return completion.direct_indirect_count;
+    if (tab === "fixed_variable") return completion.fixed_variable_count;
+    return completion.drivers_count;
+  }
+
+  function isComplete(tab: TabKey): boolean {
+    return countFor(tab) > 0;
+  }
+
+  async function handleMarkComplete(tab: TabKey) {
+    setIsSaving(true);
+    try {
+      const criterion: AllocationCriterion = tab;
+      const currentCount = countFor(tab);
+      // POST at least 1 (Pydantic rejects count=0) — backend persists the count
+      // verbatim. For the wizard, the actual row registration is in Epic 2/9;
+      // here we flip completion by stamping the count if the user hasn't yet.
+      const targetCount = Math.max(currentCount, 1);
+      const res = await saveAllocationCriterion(criterion, targetCount, accessToken);
+      onSaved({
+        ...(completion as CompletionStatus),
+        ...(tab === "direct_indirect"
+          ? { direct_indirect_count: targetCount }
+          : tab === "fixed_variable"
+            ? { fixed_variable_count: targetCount }
+            : { drivers_count: targetCount }),
+        is_complete: res.is_complete,
+        missing: res.missing,
+      });
+    } catch (e) {
+      const msg = e instanceof ApiError ? e.message : String(e);
+      onError(msg);
+    } finally {
+      setIsSaving(false);
+    }
+  }
+
+  return (
+    <section
+      aria-labelledby="wizard-allocation-heading"
+      style={{
+        padding: "1.25rem 1.5rem",
+        border: "1px solid #e2e8f0",
+        borderRadius: 8,
+        background: "#fff",
+        marginBottom: "1rem",
+      }}
+    >
+      <h2
+        id="wizard-allocation-heading"
+        style={{ fontSize: "1.125rem", fontWeight: 700, marginBottom: "0.25rem" }}
+      >
+        배부기준 3종
+      </h2>
+      <p style={{ color: "#475569", fontSize: "0.9rem", marginBottom: "0.75rem" }}>
+        업종: <strong>{industry ?? "(미설정)"}</strong>
+        {!driversRequired ? " — 제조업은 동인 정의를 건너뜁니다 (A11)" : ""}
+      </p>
+
+      <div
+        role="tablist"
+        aria-label="배부기준 탭"
+        style={{
+          display: "flex",
+          gap: 4,
+          borderBottom: "1px solid #e2e8f0",
+          marginBottom: "0.75rem",
+        }}
+      >
+        {visibleTabs.map((tab) => {
+          const selected = tab.key === active;
+          return (
+            <button
+              key={tab.key}
+              type="button"
+              role="tab"
+              aria-selected={selected}
+              onClick={() => setActive(tab.key)}
+              style={{
+                padding: "0.5rem 0.75rem",
+                border: "none",
+                borderBottom: selected ? "2px solid #2563eb" : "2px solid transparent",
+                background: "transparent",
+                color: selected ? "#1d4ed8" : "#475569",
+                fontWeight: selected ? 700 : 500,
+                cursor: "pointer",
+              }}
+            >
+              {tab.label}
+            </button>
+          );
+        })}
+      </div>
+
+      {visibleTabs
+        .filter((tab) => tab.key === active)
+        .map((tab) => {
+          const count = countFor(tab.key);
+          const done = isComplete(tab.key);
+          return (
+            <div key={tab.key} role="tabpanel" aria-label={tab.label}>
+              <p style={{ color: "#475569", marginBottom: "0.5rem" }}>{tab.description}</p>
+              <p style={{ marginBottom: "0.75rem" }}>
+                현재 등록: <strong>{count}</strong>행{" "}
+                {done ? (
+                  <span style={{ color: "#15803d", fontWeight: 600 }}>✓ 완료</span>
+                ) : (
+                  <span style={{ color: "#b45309", fontWeight: 600 }}>미완료</span>
+                )}
+              </p>
+              <div style={{ display: "flex", gap: 8 }}>
+                <a
+                  href={tab.addHref}
+                  style={{
+                    padding: "0.5rem 1rem",
+                    background: "#0f172a",
+                    color: "#fff",
+                    borderRadius: 6,
+                    textDecoration: "none",
+                    fontWeight: 600,
+                  }}
+                >
+                  추가 / 편집 (Epic {tab.key === "drivers" ? "9" : "2"})
+                </a>
+                <button
+                  type="button"
+                  onClick={() => handleMarkComplete(tab.key)}
+                  disabled={isSaving || done}
+                  aria-busy={isSaving}
+                  style={{
+                    padding: "0.5rem 1rem",
+                    background: isSaving || done ? "#94a3b8" : "#2563eb",
+                    color: "#fff",
+                    border: "none",
+                    borderRadius: 6,
+                    cursor: isSaving || done ? "not-allowed" : "pointer",
+                    fontWeight: 600,
+                  }}
+                >
+                  {isSaving ? "저장 중…" : done ? "저장됨" : "완료로 표시"}
+                </button>
+              </div>
+            </div>
+          );
+        })}
+    </section>
+  );
+}
