@@ -0,0 +1,146 @@
+/**
+ * apps/web/components/settings/wizard/SettingsWizardClient.tsx
+ *
+ * Story 1.2 — Task 5.1 (Client Component body). Owns the completion-status
+ * state shared by the 4 step components + the [계산] button (Task 6).
+ *
+ * Each step's `onSaved` callback patches the local `completion` state
+ * from the server's response (`is_complete`, `missing`). The
+ * `useSettingsCompletion` hook keeps the server-side view in sync via
+ * background polling (5-second stale window, 30-second cadence).
+ *
+ * F-1: a function prop CANNOT be passed across the RSC boundary, so the
+ * Server Component page hands a STRING (`accessToken`) here and this
+ * Client Component constructs the handlers internally.
+ */
+
+"use client";
+
+import { useCallback, useState } from "react";
+
+import { useSettingsCompletion } from "@/hooks/useSettingsCompletion";
+import type { CompletionStatus } from "@/lib/api-client";
+
+import { AllocationCriteriaStep } from "./AllocationCriteriaStep";
+import { CurrencyStep } from "./CurrencyStep";
+import { FiscalYearStartStep } from "./FiscalYearStartStep";
+import { LanguageStep } from "./LanguageStep";
+
+export interface SettingsWizardClientProps {
+  accessToken?: string;
+}
+
+export function SettingsWizardClient({ accessToken }: SettingsWizardClientProps) {
+  const { status, refetch } = useSettingsCompletion(accessToken);
+  const [completion, setCompletion] = useState<CompletionStatus | null>(status);
+  const [errorMessage, setErrorMessage] = useState<string | null>(null);
+
+  // Keep local completion state in sync with polled hook.
+  if (status && completion && status.trace_id !== completion.trace_id) {
+    setCompletion(status);
+  } else if (status && !completion) {
+    setCompletion(status);
+  }
+
+  const handleSaved = useCallback((next: CompletionStatus) => {
+    setCompletion(next);
+    setErrorMessage(null);
+    refetch();
+  }, [refetch]);
+
+  const handleError = useCallback((msg: string) => {
+    setErrorMessage(msg);
+  }, []);
+
+  return (
+    <div>
+      {errorMessage && (
+        <div
+          role="alert"
+          style={{
+            padding: "0.75rem 1rem",
+            background: "#fee2e2",
+            border: "1px solid #fca5a5",
+            color: "#991b1b",
+            borderRadius: 6,
+            marginBottom: "1rem",
+          }}
+        >
+          저장 실패: {errorMessage}
+        </div>
+      )}
+
+      <FiscalYearStartStep
+        initial={
+          completion?.fiscal_year_start_completed
+            ? (typeof (completion as unknown as Record<string, unknown>)["fiscal_year_start"] === "string"
+                ? ((completion as unknown as Record<string, unknown>)["fiscal_year_start"] as string)
+                : null)
+            : null
+        }
+        completion={completion}
+        accessToken={accessToken}
+        onSaved={handleSaved}
+        onError={handleError}
+      />
+
+      <CurrencyStep
+        initial={
+          completion?.currency_completed
+            ? (typeof (completion as unknown as Record<string, unknown>)["currency"] === "string"
+                ? ((completion as unknown as Record<string, unknown>)["currency"] as "KRW" | "USD")
+                : null)
+            : null
+        }
+        completion={completion}
+        accessToken={accessToken}
+        onSaved={handleSaved}
+        onError={handleError}
+      />
+
+      <LanguageStep
+        initial={completion?.language_completed ? "ko-KR" : null}
+        completion={completion}
+        accessToken={accessToken}
+        onSaved={handleSaved}
+        onError={handleError}
+      />
+
+      <AllocationCriteriaStep
+        completion={completion}
+        industry={
+          typeof (completion as unknown as Record<string, unknown> | null)?.["industry"] ===
+          "string"
+            ? ((completion as unknown as Record<string, unknown>)["industry"] as string)
+            : null
+        }
+        accessToken={accessToken}
+        onSaved={handleSaved}
+        onError={handleError}
+      />
+
+      {completion && (
+        <aside
+          aria-label="설정 완료 상태"
+          style={{
+            padding: "0.75rem 1rem",
+            background: completion.is_complete ? "#dcfce7" : "#fef3c7",
+            border: `1px solid ${completion.is_complete ? "#86efac" : "#fcd34d"}`,
+            borderRadius: 6,
+            marginTop: "1rem",
+          }}
+        >
+          {completion.is_complete ? (
+            <span style={{ color: "#15803d", fontWeight: 600 }}>
+              ✓ 모든 설정이 완료되었습니다 — [계산] 버튼을 사용할 수 있습니다.
+            </span>
+          ) : (
+            <span style={{ color: "#92400e" }}>
+              ⚠ 미완료 항목: {completion.missing.join(", ")}
+            </span>
+          )}
+        </aside>
+      )}
+    </div>
+  );
+}
