+        if row.tenant_id != self.tenant_id:
+            # Defense-in-depth — RLS already blocks this at DB layer.
+            raise BackupNotFoundError(
+                backup_id=backup_id,
+                tenant_id=self.tenant_id,
+                trace_id=self.trace_id,
+            )
+        if row.purged_at is not None:
+            raise BackupNotFoundError(
+                backup_id=backup_id,
+                tenant_id=self.tenant_id,
+                trace_id=self.trace_id,
