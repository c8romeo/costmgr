+    result: dict[str, Any] = asyncio.run(_invoke())
+    # Service-only tenant → some verdict envelope must be returned
+    assert isinstance(result, dict)
+    assert result["code"] == "V3"
+    assert result["status"] in {"passed", "failed", "skipped"}
