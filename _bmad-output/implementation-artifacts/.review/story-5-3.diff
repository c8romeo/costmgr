+): Promise<import("./closing-guard").ClosingGuardEvaluateResponse> {
+  const { data } = await request<
+    import("./closing-guard").ClosingGuardEvaluateResponse
+  >(
+    "/api/v1/inventory/closing-guard/evaluate",
