diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,332 @@
+name: ci
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+    branches: [main]
+
+# CI-3 (CR 2026-07-25): do NOT cancel in-progress on PR builds — the
+# stack-pin-check must complete to record drift annotations. On push to
+# main, cancellation is fine (only the latest commit matters).
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: ${{ github.event_name != 'pull_request' }}
+
+jobs:
+  # ─────────────────────────────────────────────────────────
+  # 1. setup (shared cache)
+  # ─────────────────────────────────────────────────────────
+  setup:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27529564c616888 # v4.2.2
+      - uses: actions/setup-node@0a44ba7841725637a19e28fa30b79a866c81b0a6 # v6.1.0
+        with:
+          node-version-file: ".nvmrc"
+      - uses: actions/setup-python@82c7e631bb3cdc910f68e0081d67478d79c6982d # v6.1.1
+        with:
+          python-version-file: ".python-version"
+      - name: Install uv
+        run: pip install uv==0.11.32
+      - name: Cache uv
+        uses: actions/cache@5a3e84c9ed5f96e6bccc1e24985906d792b805ed # v4.2.1
+        with:
+          path: ~/.cache/uv
+          key: uv-${{ runner.os }}-${{ hashFiles('pyproject.toml', 'uv.lock') }}
+      - name: Cache pnpm
+        uses: actions/cache@5a3e84c9ed5f96e6bccc1e24985906d792b805ed # v4.2.1
+        with:
+          path: ~/.local/share/pnpm/store
+          key: pnpm-${{ runner.os }}-${{ hashFiles('pnpm-lock.yaml') }}
+      - name: Install JS deps
+        run: pnpm install --frozen-lockfile
+      - name: Install Python deps
+        run: uv sync --frozen
+
+  # ─────────────────────────────────────────────────────────
+  # 2. lint-deps (dependency-cruiser, Story 0.1)
+  # ─────────────────────────────────────────────────────────
+  lint-deps:
+    needs: setup
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27529564c616888 # v4.2.2
+      - uses: actions/setup-node@0a44ba7841725637a19e28fa30b79a866c81b0a6 # v6.1.0
+        with: { node-version-file: ".nvmrc" }
+      - run: pnpm install --frozen-lockfile
+      - run: pnpm lint:deps
+
+  # ─────────────────────────────────────────────────────────
+  # 3. lint-imports (import-linter, Story 0.1)
+  # ─────────────────────────────────────────────────────────
+  lint-imports:
+    needs: setup
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27529564c616888 # v4.2.2
+      - uses: actions/setup-python@82c7e631bb3cdc910f68e0081d67478d79c6982d # v6.1.1
+        with: { python-version-file: ".python-version" }
+      - run: pip install uv==0.11.32
+      - run: uv sync --frozen
+      - name: Run import-linter
+        run: uv run import-linter lint
+
+  # ─────────────────────────────────────────────────────────
+  # 4. lint-conventions (Story 0.4 — AD-8 monetary + AD-15 naming)
+  # ─────────────────────────────────────────────────────────
+  # Runs ruff (Python) + ESLint (TypeScript) + custom money-type linter +
+  # migration linters. Failure message includes violated AD reference.
+  lint-conventions:
+    needs: setup
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27529564c616888 # v4.2.2
+      - uses: actions/setup-node@0a44ba7841725637a19e28ba30b79a866c81b0a6 # v6.1.0
+        with: { node-version-file: ".nvmrc" }
+      - uses: actions/setup-python@82c7e631bb3cdc910f68e0081d67478d79c6982d # v6.1.1
+        with: { python-version-file: ".python-version" }
+      - run: pip install uv==0.11.32
+      - run: pnpm install --frozen-lockfile
+      - run: uv sync --frozen
+      - name: Run lint-conventions (ruff + custom money + migration linters)
+        run: make lint-conventions
+        env:
+          PYTHONIOENCODING: utf-8
+      - name: Annotate convention violation on PR
+        if: failure() && github.event_name == 'pull_request'
+        uses: actions/github-script@60f0c1deea2cdc3e9f9e5bdb7e2734458699cd15 # v7.0.1
+        with:
+          script: |
+            const msg = 'CONVENTION_VIOLATION detected. Check ruff / ESLint / money-type / migration linter output for the violated AD reference (AD-8 or AD-15).';
+            github.rest.issues.createComment({
+              issue_number: context.issue.number,
+              owner: context.repo.owner,
+              repo: context.repo.repo,
+              body: msg,
+            });
+
+  # ─────────────────────────────────────────────────────────
+  # 5. stack-pin-check (Story 0.3 — AD-14 lockfile guard)
+  # ─────────────────────────────────────────────────────────
+  stack-pin-check:
+    needs: setup
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27529564c616888 # v4.2.2
+        with:
+          # fetch-depth: 0 so `git log -1` sees the full commit message
+          fetch-depth: 0
+      - uses: actions/setup-node@0a44ba7841725637a19e28fa30b79a866c81b0a6 # v6.1.0
+        with: { node-version-file: ".nvmrc" }
+      - uses: actions/setup-python@82c7e631bb3cdc910f68e0081d67478d79c6982d # v6.1.1
+        with: { python-version-file: ".python-version" }
+      - run: pip install uv==0.11.32
+      - name: Install JS deps (frozen)
+        run: pnpm install --frozen-lockfile
+      - name: Install Python deps (frozen)
+        run: uv sync --frozen
+      # CI-1 (CR 2026-07-25): For PR builds, the HEAD commit is the merge
+      # commit (squash-merge workflow). The `[STACK BUMP]` tag lives on the
+      # PR's actual head commit. Pass it via env var so the check scripts
+      # can authorize drift using the PR commit, not the merge commit.
+      - name: Compute PR head commit (for [STACK BUMP] authorization)
+        if: github.event_name == 'pull_request'
+        id: pr_head
+        run: |
+          HEAD_SHA="${{ github.event.pull_request.head.sha }}"
+          echo "head_sha=$HEAD_SHA" >> "$GITHUB_OUTPUT"
+      - name: Node pin check
+        id: node_check
+        run: |
+          set +e
+          if [ -n "${{ steps.pr_head.outputs.head_sha }}" ]; then
+            node scripts/check_stack_pin.mjs
+            exit_code=$?
+          else
+            node scripts/check_stack_pin.mjs
+            exit_code=$?
+          fi
+          echo "exit=$exit_code"
+          exit $exit_code
+        env:
+          PYTHONIOENCODING: utf-8
+          # When on a PR, prefer the PR head commit for the bump-tag check.
+          STACK_BUMP_PR_HEAD_SHA: ${{ steps.pr_head.outputs.head_sha }}
+      - name: Python pin check
+        id: py_check
+        run: |
+          set +e
+          uv run python scripts/check_stack_pin.py
+          exit_code=$?
+          echo "exit=$exit_code"
+          exit $exit_code
+        env:
+          PYTHONIOENCODING: utf-8
+          STACK_BUMP_PR_HEAD_SHA: ${{ steps.pr_head.outputs.head_sha }}
+      - name: Annotate drift on PR
+        if: failure() && github.event_name == 'pull_request'
+        uses: actions/github-script@60f0c1deea2cdc3e9f9e5bdb7e2734458699cd15 # v7.0.1
+        with:
+          script: |
+            const drift = 'STACK_PIN_VIOLATION detected. Add `[STACK BUMP]` to the PR commit message to authorize this drift.';
+            github.rest.issues.createComment({
+              issue_number: context.issue.number,
+              owner: context.repo.owner,
+              repo: context.repo.repo,
+              body: drift,
+            });
+      # LABEL-1 (CR 2026-07-25): auto-apply `stack-pin-violation` label when
+      # the check fails, so branch protection can block merge per spec AC #3.
+      - name: Apply stack-pin-violation label
+        if: failure() && github.event_name == 'pull_request'
+        uses: actions/github-script@60f0c1deea2cdc3e9f9e5bdb7e2734458699cd15 # v7.0.1
+        with:
+          script: |
+            try {
+              await github.rest.issues.addLabels({
+                owner: context.repo.owner,
+                repo: context.repo.repo,
+                issue_number: context.issue.number,
+                labels: ['stack-pin-violation'],
+              });
+            } catch (e) {
+              core.warning(`Failed to apply label: ${e.message}`);
+            }
+
+  # ─────────────────────────────────────────────────────────
+  # 5. test-architecture (Story 0.1 — pytest fixture tests)
+  # ─────────────────────────────────────────────────────────
+  test-architecture:
+    needs: setup
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27529564c616888 # v4.2.2
+      - uses: actions/setup-python@82c7e631bb3cdc910f68e0081d67478d79c6982d # v6.1.1
+        with: { python-version-file: ".python-version" }
+      - run: pip install uv==0.11.32
+      - run: uv sync --frozen
+      - name: Run architecture + engine-purity tests
+        run: uv run pytest tests/architecture tests/cost_engine -v
+
+  # ─────────────────────────────────────────────────────────
+  # 6. test-service-role-guard (Story 0.2 — pure unit tests)
+  # ─────────────────────────────────────────────────────────
+  test-service-role-guard:
+    needs: setup
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27529564c616888 # v4.2.2
+      - uses: actions/setup-python@82c7e631bb3cdc910f68e0081d67478d79c6982d # v6.1.1
+        with: { python-version-file: ".python-version" }
+      - run: pip install uv==0.11.32
+      - run: uv sync --frozen
+      - name: Service-role audit-first unit tests (no DB required)
+        run: uv run pytest tests/rls/test_service_role_audit.py -v
+
+  # ─────────────────────────────────────────────────────────
+  # 7. service-role-guard-lint (Story 0.2 — Task 7.4)
+  # ─────────────────────────────────────────────────────────
+  service-role-guard-lint:
+    needs: setup
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27529564c616888 # v4.2.2
+      - name: Fail if `service_role` is invoked outside the guard module
+        run: |
+          # Operational references: function calls to with_service_role or
+          # run_with_service_role, or the JWT role string "service_role"
+          # used as a value. These indicate a caller is bypassing the guard.
+          # Doc/env-var/module-path/comment references are exempt.
+          PATTERN='with_service_role\(|run_with_service_role\(|\bservice_role\b\s*[=)]|"\s*service_role\s*"'
+          HITS=$(grep -rEn "$PATTERN" apps/api/ --include="*.py" || true)
+          # Strip comments and docstrings (lines whose first non-ws char
+          # is # or lines that look like docstring text inside module
+          # headers) — the migration file's bullet list lives inside a
+          # triple-quoted module docstring.
+          NON_DOC=$(echo "$HITS" | grep -v -E ':\s*#' || true)
+          # Allow-list: the guard module, env-var name, audit helper, tenant
+          # context, manifest, and the migration file (which documents
+          # AD-2 audit policy references in its docstring).
+          BAD=$(echo "$NON_DOC" \
+              | grep -v 'apps/api/core/service_role.py' \
+              | grep -v 'apps/api/core/settings.py' \
+              | grep -v 'apps/api/core/audit.py' \
+              | grep -v 'apps/api/core/tenant_context.py' \
+              | grep -v 'apps/api/core/__init__.py' \
+              | grep -v 'apps/api/alembic/versions/' \
+              || true)
+          if [ -n "$BAD" ]; then
+            echo "❌ service_role invoked outside the guard module:"
+            echo "$BAD"
+            exit 1
+          fi
+          echo "✅ service_role only invoked in apps/api/core/service_role.py"
+
+  # ─────────────────────────────────────────────────────────
+  # 8. rls-tests (Story 0.2 — tenant isolation, CI-only)
+  # ─────────────────────────────────────────────────────────
+  rls-tests:
+    needs: setup
+    runs-on: ubuntu-latest
+    # Per Decision 2 (2026-07-25): Docker CI-only. Local dev is skipped.
+    # DOCKER-2 (CR 2026-07-25): postgres:15 is pinned by digest to lock the
+    # CI service image against silent drift.
+    services:
+      postgres:
+        image: postgres:15@sha256:74e110c41804365e3915fcc09d5e7a1eff50161aaa94d5da0e58e0cd75ae509c
+        env:
+          POSTGRES_USER: postgres
+          POSTGRES_PASSWORD: postgres
+          POSTGRES_DB: postgres
+        ports:
+          - 54322:5432
+        options: >-
+          --health-cmd pg_isready
+          --health-interval 10s
+          --health-timeout 5s
+          --health-retries 5
+    env:
+      CI: "true"
+      # alembic env.py reads DATABASE_URL (RLS-CI-1). Use the asyncpg
+      # driver so async_engine_from_config works (RLS-CI-2).
+      DATABASE_URL: "postgresql+asyncpg://postgres:postgres@localhost:54322/postgres"
+      # Tenant isolation tests run as costmgr_test (NOBYPASSRLS) so
+      # RLS actually filters rows (RLS-CI-4).
+      RLS_TEST_DATABASE_URL: "postgresql://costmgr_test:costmgr_test@localhost:54322/postgres"
+      RLS_BOOTSTRAP_DATABASE_URL: "postgresql://postgres:postgres@localhost:54322/postgres"
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27529564c616888 # v4.2.2
+      - uses: actions/setup-python@82c7e631bb3cdc910f68e0081d67478d79c6982d # v6.1.1
+        with: { python-version-file: ".python-version" }
+      - run: pip install uv==0.11.32
+      - run: uv sync --frozen
+      - name: Install psql
+        run: apt-get update -qq && apt-get install -y -qq postgresql-client >/dev/null
+      - name: Apply Alembic migration
+        run: uv run alembic -c apps/api/alembic.ini upgrade head
+      - name: Apply Supabase CI shim (auth.jwt() stub + service_role + costmgr_test roles)
+        run: |
+          PGPASSWORD=postgres psql -v ON_ERROR_STOP=1 \
+            -h localhost -p 54322 -U postgres -d postgres \
+            -f supabase/policies/0000_supabase_ci_shim.sql
+      - name: Apply RLS policies
+        run: |
+          PGPASSWORD=postgres psql -v ON_ERROR_STOP=1 \
+            -h localhost -p 54322 -U postgres -d postgres \
+            -f supabase/policies/0001_rls_policies.sql
+      - name: RLS smoke test
+        run: |
+          PGPASSWORD=postgres psql -v ON_ERROR_STOP=1 \
+            -h localhost -p 54322 -U postgres -d postgres \
+            -f supabase/policies/0002_rls_smoke_test.sql
+      - name: Run RLS tests
+        run: uv run pytest tests/rls -v --tb=short --junitxml=pytest-rls.xml
+      - name: Upload test results
+        if: always()
+        uses: actions/upload-artifact@5d5cc99d66b86fc1631cb4e6c5e34ba1da8e4887 # v4.4.0
+        with:
+          name: rls-test-results
+          path: |
+            pytest-rls.xml
+            .pytest_cache/
+          if-no-files-found: ignore

