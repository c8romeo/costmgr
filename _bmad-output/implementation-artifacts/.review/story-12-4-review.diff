+                if user.totp_enabled_at
+                else None
+            ),
+            "recovery_codes_remaining": remaining,
+            "failed_attempts": user.totp_failed_attempts or 0,
+            "locked_out": bool(locked),
+            "lockout_until": (
+                user.totp_lockout_until.isoformat()
+                if user.totp_lockout_until
+                else None
