+            message=f"actor_id must be UUID, got {type(actor_id).__name__!r}",warning: in the working copy of 'packages/services/m11_close/reversal_corrected.py', LF will be replaced by CRLF the next time Git touches it

+            error_code=ERROR_CODE_NON_UUID_ACTOR,
+        )
