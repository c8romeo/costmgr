+M11_REJECT_LOCKED_KO: Final[str] = "잠긴 기간 — 역분개 불가"
+M11_REJECT_NO_CAPABILITY_KO: Final[str] = "역분개 권한 미보유"
+M11_REJECT_TARGET_NOT_REVERSIBLE_KO: Final[str] = (
