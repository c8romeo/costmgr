+
+
+# ── authorize_reversal ───────────────────────────────────────
+def authorize_reversal(
+    *,
+    tenant_id: uuid.UUID,
+    target_event: InventoryLedgerEvent,
+    actor_id: uuid.UUID,
+    period_status: str,
+    capability_granted: bool,
