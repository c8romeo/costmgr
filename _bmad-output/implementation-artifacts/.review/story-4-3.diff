@@ -18,6 +20,7 @@ generated by `packages.common.uuid7`.
 
 from __future__ import annotations
 
+import uuid
 from datetime import datetime
 from decimal import Decimal
 from uuid import UUID
@@ -616,3 +619,157 @@ class MonthlyInputRow(Base):
             name="monthly_input_rows_company_burden_rate_range",
         ),
     )
+
+
+# ── fiscal_period_snapshots (Story 4.2 — Task 1.4) ────────────
+# Append-only-leaning ledger (AD-22) of per-tenant per-period calculation
+# results. M3 module is the only writer (services/calc_orchestrator.py).
+# State field tracks verified → committed (M11, Epic 11) → reversed (Epic 11
+# Story 11-3). `engine_type='trad'` is the default — Epic 9 Story 9-2 will
+# INSERT 'abc' rows for ABC costing.
+#
+# Idempotency (AC #4): the UNIQUE constraint on
+# (tenant_id, period_key, baseline_revision, engine_type) guarantees
+# one snapshot per (tenant, period, baseline, engine). Re-INSERT attempt
+# raises `IntegrityError` which the orchestrator catches + checks
+# result_hash for the same-hash idempotent skip path.
+#
+# AD-8: KRW fields are `BIGINT` (1원 precision). Engine's `result_hash`
+# is 64-char hex SHA-256 (EP-IC-1).
+class FiscalPeriodSnapshot(Base):
+    __tablename__ = "fiscal_period_snapshots"
+
+    snapshot_id: Mapped[UUID] = mapped_column(
+        PgUUID(as_uuid=True), primary_key=True, default=uuid.uuid4
+    )
+    tenant_id: Mapped[UUID] = mapped_column(
+        PgUUID(as_uuid=True),
+        ForeignKey("tenants.id", ondelete="CASCADE"),
+        nullable=False,
+    )
+    period_key: Mapped[str] = mapped_column(Text, nullable=False)
+    baseline_revision: Mapped[int] = mapped_column(
+        Integer, nullable=False, default=1
+    )
+    engine_type: Mapped[str] = mapped_column(
+        Text, nullable=False, default="trad"
+    )
+    material_cost: Mapped[int] = mapped_column(BigInteger, nullable=False)
+    labor_cost: Mapped[int] = mapped_column(BigInteger, nullable=False)
+    overhead_cost: Mapped[int] = mapped_column(BigInteger, nullable=False)
+    manufacturing_cost: Mapped[int] = mapped_column(BigInteger, nullable=False)
+    inventory_adjustment: Mapped[int] = mapped_column(
+        BigInteger, nullable=False, default=0
+    )
+    result_hash: Mapped[str] = mapped_column(Text, nullable=False)
+    state: Mapped[str] = mapped_column(Text, nullable=False)
+    created_at: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True), nullable=False
+    )
+
+    __table_args__ = (
+        CheckConstraint(
+            "state IN ('verified', 'committed', 'reversed')",
+            name="fiscal_period_snapshots_state_check",
+        ),
+        CheckConstraint(
+            "baseline_revision >= 1",
+            name="fiscal_period_snapshots_revision_positive",
+        ),
+        UniqueConstraint(
+            "tenant_id", "period_key", "baseline_revision", "engine_type",
+            name="uq_fiscal_period_snapshots_tenant_period_revision_engine",
+        ),
+    )
+
+
+# ── calc_log (Story 4.2 — Task 1.4) ───────────────────────────
+# Audit-first ledger (CR 1.1 lesson) for the M3 calculation flow. Written
+# BEFORE fiscal_period_snapshots INSERT in the same REPEATABLE READ
+# transaction. `action` discriminates: `compute` (first write),
+# `idempotent_skip` (same-hash re-call), `rollback` (engine error →
+# ROLLBACK). `result_hash` is nullable because `rollback` may fire
+# before the engine produces a stable hash.
+class CalcLog(Base):
+    __tablename__ = "calc_log"
+
+    calc_log_id: Mapped[UUID] = mapped_column(
+        PgUUID(as_uuid=True), primary_key=True, default=uuid.uuid4
+    )
+    tenant_id: Mapped[UUID] = mapped_column(
+        PgUUID(as_uuid=True),
+        ForeignKey("tenants.id", ondelete="CASCADE"),
+        nullable=False,
+    )
+    period_key: Mapped[str] = mapped_column(Text, nullable=False)
+    baseline_revision: Mapped[int] = mapped_column(
+        Integer, nullable=False
+    )
+    engine_type: Mapped[str] = mapped_column(
+        Text, nullable=False, default="trad"
+    )
+    action: Mapped[str] = mapped_column(Text, nullable=False)
+    result_hash: Mapped[str | None] = mapped_column(Text, nullable=True)
+    trace_id: Mapped[str] = mapped_column(Text, nullable=False)
+    created_at: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True), nullable=False
+    )
+
+    __table_args__ = (
+        CheckConstraint(
+            "action IN ('compute', 'idempotent_skip', 'rollback')",
+            name="calc_log_action_check",
+        ),
+        CheckConstraint(
+            "baseline_revision >= 1",
+            name="calc_log_revision_positive",
+        ),
+    )
+
+
+# ── verification_log (Story 4.3 — Task 4.1) ───────────────────
+# AD-12 verification-first audit ledger. Written by
+# `CalcOrchestrator._write_verification_log` in the same REPEATABLE READ
+# transaction as `calc_log` (audit-first, CR 1.1 lesson) and BEFORE
+# `fiscal_period_snapshots` INSERT.
+#
+# Note: `top_failure_code` and `top_failure_message_ko` are populated
+# only for `action='verification_failed'` (the AD-12 first-failed rule).
+# For `action='verification_passed'`, both fields are NULL.
+#
+# The CHECK constraint defines the 3-value enum that the
+# `apps/api/core/audit_action.py` registry (ActionClass.VERIFICATION_LOG)
+# validates against in production writes. Phase 4 drift detector will
+# enforce 3-way consistency (registry vs DB CHECK vs call sites).
+class VerificationLog(Base):
+    __tablename__ = "verification_log"
+
+    verification_log_id: Mapped[UUID] = mapped_column(
+        PgUUID(as_uuid=True), primary_key=True, default=uuid.uuid4
+    )
+    tenant_id: Mapped[UUID] = mapped_column(
+        PgUUID(as_uuid=True),
+        ForeignKey("tenants.id", ondelete="CASCADE"),
+        nullable=False,
+    )
+    period_key: Mapped[str] = mapped_column(Text, nullable=False)
+    baseline_revision: Mapped[int] = mapped_column(Integer, nullable=False)
+    action: Mapped[str] = mapped_column(Text, nullable=False)
+    top_failure_code: Mapped[str | None] = mapped_column(Text, nullable=True)
+    top_failure_message_ko: Mapped[str | None] = mapped_column(Text, nullable=True)
+    result_hash: Mapped[str] = mapped_column(Text, nullable=False)
+    trace_id: Mapped[str] = mapped_column(Text, nullable=False)
+    created_at: Mapped[datetime] = mapped_column(
+        DateTime(timezone=True), nullable=False
+    )
+
+    __table_args__ = (
+        CheckConstraint(
+            "action IN ('verification_passed', 'verification_failed', 'verification_skipped')",
+            name="verification_log_action_check",
+        ),
+        CheckConstraint(
+            "baseline_revision >= 1",
+            name="verification_log_revision_positive",
+        ),
+    )
