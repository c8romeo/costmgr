+        assert M11_REJECT_LOCKED_KO == "잠긴 기간 — 역분개 불가"
+
+    def test_m11_reject_no_capability_ko(self) -> None:
+        """M11_REJECT_NOwarning: in the working copy of 'tests/services/m11_close/test_reversal_corrected.py', LF will be replaced by CRLF the next time Git touches it
_CAPABILITY_KO = '역분개 권한 미보유'."""
+        assert M11_REJECT_NO_CAPABILITY_KO == "역분개 권한 미보유"
