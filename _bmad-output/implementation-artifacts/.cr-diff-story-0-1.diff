+# import-linter — architectural boundary enforcement (AD-1, AD-11)
+# ─────────────────────────────────────────────────────────
+[tool.importlinter]
+# Use `packages` as the root — `packages.cost_engine` contracts work.
+# PYTHONPATH=apps:packages:. must be set when invoking lint-imports.
+#
+# KNOWN LIMITATION (Story 0.1): import-linter requires a single root_package,
+# so contracts that span `apps.api` ↔ `packages.*` are not enforceable via
+# import-linter. They are enforced instead by:
+#   - tests/architecture/test_api_calls_only_ports.py  (AST + runtime)
+#   - tests/cost_engine/test_no_io_imports.py          (AST)
+# Story 0.3 will re-anchor this when the monorepo gains a top-level
+# `costmgr` namespace package.
+root_package = "packages"
+include_external_packages = true
+
+[[tool.importlinter.contracts]]
+name = "cost_engine_forbidden_io"
+type = "forbidden"
+source_modules = ["packages.cost_engine"]
+forbidden_modules = [
+    "sqlalchemy",
+    "fastapi",
+    "starlette",
+    "requests",
+    "httpx",
+    "psycopg",
+    "asyncpg",
+    "time",
+    "random",
+    "os",
+    "socket",
+    "subprocess",
+]
+
+[[tool.importlinter.contracts]]
+name = "engine_core_to_adapters_forbidden"
+type = "forbidden"
+source_modules = ["packages.cost_engine.core"]
+forbidden_modules = [
+    "packages.cost_engine.adapters",
+]
+
+# ─────────────────────────────────────────────────────────
+# ruff — Python lint + format (AD-15, AD-8)
+# ─────────────────────────────────────────────────────────
+[tool.ruff]
+line-length = 100
+target-version = "py312"
+extend-exclude = ["node_modules", ".venv", "dist", "build", ".next"]
+
+[tool.ruff.lint]
+select = ["E", "F", "W", "I", "N", "UP", "B", "A", "C4", "PT", "SIM", "RET", "ARG", "PTH", "ERA"]
+ignore = ["E501"]
+
+[tool.ruff.lint.per-file-ignores]
+"tests/**/*.py" = ["B011", "N802"]
+"apps/api/alembic/versions/*.py" = ["E501"]
+
+[tool.ruff.format]
+quote-style = "double"
+indent-style = "space"
+
+# ─────────────────────────────────────────────────────────
+# pytest — discover tests/cost_engine + tests/architecture
+# ─────────────────────────────────────────────────────────
+[tool.pytest.ini_options]
+minversion = "9.0"
+testpaths = ["tests"]
+pythonpath = ["apps", "packages", "."]
+addopts = ["-warning: in the working copy of 'scripts/check_stack_pin.mjs', LF will be replaced by CRLF the next time Git touches it
