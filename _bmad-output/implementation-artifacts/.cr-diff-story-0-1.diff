+#!/usr/bin/env node
+// scripts/check_stack_pin.mjs — minimal stack pin check stub (Story 0.3 will expand)
+import { readFileSync, existsSync } from 'node:fs';
+import { exit } from 'node:process';
+
+const pin = {
+  node: '24.18.0',
+  python: '3.12',
+  pnpm: '9.15.0',
+};
+
+let ok = true;
+
+const nvmrc = existsSync('.nvmrc') ? readFileSync('.nvmrc', 'utf8').trim() : null;
+if (nvmrc !== pin.node) {
+  console.error(`[STACK_PIN] node drift: .nvmrc=${nvmrc} expected=${pin.node}`);
+  ok = false;
+} else {
+  console.log(`[STACK_PIN] node OK (${pin.node})`);
+}
+
+const pyver = existsSync('.python-version') ? readFileSync('.python-version', 'utf8').trim() : null;
+if (pyver !== pin.python) {
+  console.error(`[STACK_PIN] python drift: .python-version=${pyver} expected=${pin.python}`);
+  ok = false;
+} else {
+  console.log(`[STACK_PIN] python OK (${pin.python})`);
+}
+
+const pkg = JSON.parse(readFileSync('package.json', 'utf8'));
+if (pkg.packageManager && !pkg.packageManager.startsWith(`pnpm@`)) {
+  console.error(`[STACK_PIN] packageManager drift: ${pkg.packageManager}`);
+  ok = false;
+} else {
+  console.log(`[STACK_PIN] pnpm OK (${pkg.packageManager || 'unspecified'})`);
+}
+
+exit(ok ? 0 : 1);
