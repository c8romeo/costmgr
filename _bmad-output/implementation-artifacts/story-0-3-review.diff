+#!/usr/bin/env node
+// scripts/check_stack_pin.mjs — Stack pin check (Story 0.3)
+// Reads docs/STACK_PIN.yaml and verifies the actual repo state matches.
+// Exits 0 if all match, 1 if any drift (unless [STACK BUMP] tag is present).
+//
+// Usage:
+//   node scripts/check_stack_pin.mjs                 # default: enforced
+//   VERBOSE=1 node scripts/check_stack_pin.mjs       # show all expected vs actual
+//   STACK_BUMP=1 node scripts/check_stack_pin.mjs    # authorize drift (CI uses
+//                                                     commit-message tag; this
+//                                                     is for local testing)
+//
+// The drift authorization is also recognized via the most recent commit
+// message (git log -1 --format=%s) containing the literal "[STACK BUMP]".
+
+import { readFileSync, existsSync } from 'node:fs';
+import { execSync } from 'node:child_process';
+import { exit } from 'node:process';
+
+// ── Minimal YAML parser for the fixed STACK_PIN.yaml format ────────────────
+//
+// Format:
+//   # comments
+//   stack_pin:
+//     key: value
+//     ...
+//   notes:
+//     key:
+//       current: value
+//       ...
+//
+// We don't need full YAML — just enough to read this structure. Handles:
+// - Top-level keys (stack_pin, notes)
+// - Nested keys (notes.<pkg>.current, .spec, .reason)
+// - Quoted / unquoted values
+// - Block scalars (|) are skipped
+
+function parseYamlSimple(text) {
+  const lines = text.split(/\r?\n/);
+  const root = {};
+  const stack = [{ indent: -1, obj: root, key: null, mode: null }];
+
+  for (const raw of lines) {
+    if (raw.trim() === '' || raw.trim().startsWith('#')) continue;
+    const indent = raw.length - raw.trimStart().length;
+    const line = raw.trim();
+
+    // Skip block scalar content (indented under a `key: |`)
+    if (indent > stack[stack.length - 1].indent && stack[stack.length - 1].mode === 'block') {
+      continue;
+    }
+    // Pop frames whose indent we are at or below
+    while (stack.length > 1 && indent <= stack[stack.length - 1].indent) {
+      stack.pop();
+    }
+
+    const m = line.match(/^([a-zA-Z_][a-zA-Z0-9_-]*)\s*:\s*(.*)$/);
+    if (!m) continue;
+    const key = m[1];
+    let value = m[2];
+
+    // Strip inline `# comment` if not inside a quoted string.
+    // STACK_PIN.yaml uses inline comments to annotate the value's purpose.
+    let inQuote = null;
+    let cutIdx = value.length;
+    for (let i = 0; i < value.length; i++) {
+      const c = value[i];
+      if (inQuote) {
+        if (c === inQuote) inQuote = null;
+      } else if (c === '"' || c === "'") {
+        inQuote = c;
+      } else if (c === '#') {
+        cutIdx = i;
+        break;
+      }
+    }
+    value = value.slice(0, cutIdx).trim();
+
+    if (value === '' || value === '|' || value === '>') {
+      // nested object (or block scalar header — skip its body)
+      const obj = {};
+      const parent = stack[stack.length - 1].obj;
+      parent[key] = obj;
+      stack.push({ indent, obj, key, mode: value === '|' ? 'block' : 'flow' });
+    } else {
+      // strip surrounding quotes
+      value = value.replace(/^["']|["']$/g, '');
+      const parent = stack[stack.length - 1].obj;
+      parent[key] = value;
+    }
+  }
+  return root;
+}
+
+// ── Helpers ─────────────────────────────────────────────────────────────────
+
+const ROOT = process.cwd();
+const VERBOSE = process.env.VERBOSE === '1' || process.env.VERBOSE === 'true';
+
+function read(path) {
+  const full = `${ROOT}/${path}`;
+  if (!existsSync(full)) throw new Error(`missing: ${path}`);
+  return readFileSync(full, 'utf8');
+}
+
+function readJson(path) {
+  return JSON.parse(read(path));
+}
+
+function readTomlKey(pyproject, key) {
+  // Naive extractor for `key = "value"` or `key = number`
+  const re = new RegExp(`^${key}\\s*=\\s*"?([^"\\n]+)"?`, 'm');
+  const m = pyproject.match(re);
+  return m ? m[1].trim() : null;
+}
+
+function hasCommitTag(tag) {
+  try {
+    const msg = execSync('git log -1 --format=%s', { encoding: 'utf8', stdio: ['pipe', 'pipe', 'ignore'] });
+    return msg.includes(tag);
+  } catch {
+    return false;
+  }
+}
+
+// ── Load pin table ─────────────────────────────────────────────────────────
+
+if (!existsSync(`${ROOT}/docs/STACK_PIN.yaml`)) {
+  console.error('❌ docs/STACK_PIN.yaml not found');
+  exit(2);
+}
+const pinDoc = parseYamlSimple(read('docs/STACK_PIN.yaml'));
+const PIN = pinDoc.stack_pin || {};
+
+// ── Drift authorization ───────────────────────────────────────────────────
+
+const bumpFromCommit = hasCommitTag('[STACK BUMP]');
+const bumpFromEnv = process.env.STACK_BUMP === '1';
+const BUMP_OK = bumpFromCommit || bumpFromEnv;
+
+if (bumpFromCommit) {
+  console.log('[STACK_PIN] [STACK BUMP] tag present in HEAD commit — drift authorized');
+} else if (bumpFromEnv) {
+  console.log('[STACK_PIN] STACK_BUMP=1 — drift authorized (local override)');
+}
+
+// ── Checks ─────────────────────────────────────────────────────────────────
+
+const drifts = [];
+
+function check(label, expected, actual) {
+  if (expected === undefined) return; // not pinned
+  if (actual === expected) {
+    if (VERBOSE) console.log(`  ✓ ${label}: ${actual}`);
+    return;
+  }
+  drifts.push({ label, expected, actual });
+  console.log(`  ✗ ${label}: expected=${JSON.stringify(expected)} actual=${JSON.stringify(actual)}`);
+}
+
+// .nvmrc
+try {
+  const node = read('.nvmrc').trim();
+  check('node (.nvmrc)', PIN.node, node);
+} catch (e) {
+  drifts.push({ label: 'node', expected: PIN.node, actual: null });
+  console.log(`  ✗ node (.nvmrc): missing file`);
+}
+
+// .python-version
+try {
+  const py = read('.python-version').trim();
+  // Expected could be "3.12" — match exactly (no .x)
+  check('python (.python-version)', PIN.python, py);
+} catch (e) {
+  drifts.push({ label: 'python', expected: PIN.python, actual: null });
+}
+
+// package.json (root)
+const rootPkg = readJson('package.json');
+check('pnpm (package.json packageManager)', `pnpm@${PIN.pnpm}`, rootPkg.packageManager);
+check('node (package.json engines.node)', PIN.node, rootPkg.engines?.node);
+check('pnpm (package.json engines.pnpm)', PIN.pnpm, rootPkg.engines?.pnpm);
+
+// apps/web/package.json
+try {
+  const webPkg = readJson('apps/web/package.json');
+  check('next (apps/web/package.json)', PIN.next, webPkg.dependencies?.next);
+  check('react (apps/web/package.json)', PIN.react, webPkg.dependencies?.react);
+  check('react-dom (apps/web/package.json)', PIN.react_dom, webPkg.dependencies?.['react-dom']);
+  check('typescript (apps/web/package.json)', PIN.typescript, webPkg.devDependencies?.typescript);
+} catch (e) {
+  console.warn(`  ⚠ apps/web/package.json: ${e.message}`);
+}
+
+// apps/api/pyproject.toml
+try {
+  const apiToml = read('apps/api/pyproject.toml');
+  for (const pkg of ['sqlalchemy', 'alembic', 'asyncpg', 'pyjwt', 'supabase', 'pydantic-settings']) {
+    const re = new RegExp(`"${pkg}==([^"]+)"`, 'm');
+    const m = apiToml.match(re);
+    if (m && PIN[pkg]) {
+      check(`${pkg} (apps/api/pyproject.toml)`, PIN[pkg], m[1]);
+    } else if (PIN[pkg]) {
+      // Try range match for pydantic
+      const range = apiToml.match(new RegExp(`"${pkg}([^"]+)"`, 'm'));
+      if (range && PIN[pkg]?.startsWith(range[1].trim())) {
+        if (VERBOSE) console.log(`  ✓ ${pkg} (apps/api/pyproject.toml range): ${range[1].trim()}`);
+        continue;
+      }
+      drifts.push({ label: pkg, expected: PIN[pkg], actual: m ? m[1] : null });
+      console.log(`  ✗ ${pkg} (apps/api/pyproject.toml): expected=${PIN[pkg]} actual=${m ? m[1] : 'not found'}`);
+    }
+  }
+  // pydantic-core (exact)
+  const pcRe = /"pydantic-core==([^"]+)"/;
+  const pcMatch = apiToml.match(pcRe);
+  if (PIN.pydantic_core) {
+    check('pydantic-core (apps/api/pyproject.toml)', PIN.pydantic_core, pcMatch ? pcMatch[1] : null);
+  }
+  // fastapi (in [dev])
+  if (PIN.fastapi) {
+    const faMatch = apiToml.match(/"fastapi==([^"]+)"/);
+    check('fastapi (apps/api/pyproject.toml [dev])', PIN.fastawarning: in the working copy of 'scripts/check_stack_pin.py', LF will be replaced by CRLF the next time Git touches it
pi, faMatch ? faMatch[1] : null);
+  }
+} catch (e) {
+  console.warn(`  ⚠ apps/api/pyproject.toml: ${e.message}`);
+}
+
+// packages/cost_engine/pyproject.toml
+try {
+  const ceToml = read('packages/cost_engine/pyproject.toml');
+  const npMatch = ceToml.match(/"numpy==([^"]+)"/);
+  if (PIN.numpy && npMatch) {
+    check('numpy (packages/cost_engine/pyproject.toml [engine-math])', PIN.numpy, npMatch[1]);
+  }
+  const ptMatch = ceToml.match(/"pytest==([^"]+)"/);
+  if (PIN.pytest && ptMatch) {
+    check('pytest (packages/cost_engine/pyproject.toml [dev])', PIN.pytest, ptMatch[1]);
+  }
+} catch (e) {
+  console.warn(`  ⚠ packages/cost_engine/pyproject.toml: ${e.message}`);
+}
+
+// pyproject.toml (root dev deps)
+try {
+  const rootToml = read('pyproject.toml');
+  for (const pkg of ['import-linter', 'pytest', 'ruff']) {
+    const re = new RegExp(`"${pkg}==([^"]+)"`, 'm');
+    const m = rootToml.match(re);
+    if (m && PIN[pkg === 'import-linter' ? 'import_linter' : pkg]) {
+      check(`${pkg} (pyproject.toml dev)`, PIN[pkg === 'import-linter' ? 'import_linter' : pkg], m[1]);
+    }
+  }
+} catch (e) {
+  console.warn(`  ⚠ pyproject.toml: ${e.message}`);
+}
+
+// Dockerfile — base image tags
+try {
+  const dockerfile = read('Dockerfile');
+  const fromLines = dockerfile.match(/^FROM\s+([^\s@]+)(@sha256:[a-f0-9]+)?/gm) || [];
+  const images = fromLines.map(l => {
+    const m = l.match(/^FROM\s+([^\s@]+)/);
+    return m ? m[1] : null;
+  }).filter(Boolean);
+
+  if (PIN.python_slim) {
+    const found = images.find(i => i.startsWith('python:'));
+    check('python (Dockerfile base image)', `python:${PIN.python_slim}`, found);
+  }
+  if (PIN.node_alpine) {
+    const found = images.find(i => i.startsWith('node:'));
+    check('node (Dockerfile base image)', `node:${PIN.node_alpine}`, found);
+  }
+  if (PIN.nginx_alpine) {
+    const found = images.find(i => i.startsWith('nginx:'));
+    check('nginx (Dockerfile base image)', `nginx:${PIN.nginx_alpine}`, found);
+  }
+} catch (e) {
+  console.warn(`  ⚠ Dockerfile: ${e.message}`);
+}
+
+// ── Verdict ────────────────────────────────────────────────────────────────
+
+if (drifts.length === 0) {
+  console.log(`[STACK_PIN] ✅ all ${Object.keys(PIN).length} pins match`);
+  exit(0);
+}
+
+if (BUMP_OK) {
+  console.warn(`[STACK_PIN] ⚠ ${drifts.length} drift(s) detected but [STACK BUMP] authorized — pass:`);
+  for (const d of drifts) {
+    console.warn(`  - ${d.label}: ${d.expected} → ${d.actual}`);
+  }
+  exit(0);
+}
+
+console.error(`[STACK_PIN] ❌ ${drifts.length} drift(s) detected:`);
+for (const d of drifts) {
+  console.error(`  - ${d.label}: expected=${d.expected} actual=${d.actual}`);
+}
+console.error(`[STACK_PIN] Use commit tag [STACK BUMP] to authorize this drift.`);
+exit(1);
\ No newline at end of file
