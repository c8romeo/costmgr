@@ -0,0 +1,253 @@
+#!/usr/bin/env python3
+"""Stack pin check (Python mirror of check_stack_pin.mjs).
+
+Reads docs/STACK_PIN.yaml and verifies the actual repo state matches.
+Exits 0 if all match, 1 if any drift (unless [STACK BUMP] tag is present).
+
+Usage:
+    uv run python scripts/check_stack_pin.py            # default: enforced
+    VERBOSE=1 uv run python scripts/check_stack_pin.py   # show all expected vs actual
+    STACK_BUMP=1 uv run python scripts/check_stack_pin.py # authorize drift locally
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+# Force UTF-8 output on Windows consoles (cp949 by default in legacy console).
+# This avoids UnicodeEncodeError when printing markers like ✓ / ✗.
+try:
+    sys.stdout.reconfigure(encoding="utf-8")
+    sys.stderr.reconfigure(encoding="utf-8")
+except (AttributeError, OSError):
+    pass
+
+ROOT = Path(__file__).resolve().parent.parent
+
+# ── Minimal YAML parser for the fixed STACK_PIN.yaml format ────────────────
+
+
+def parse_yaml_simple(text: str) -> dict:
+    """Parse the fixed STACK_PIN.yaml structure (no PyYAML needed)."""
+    root: dict = {}
+    stack: list[dict] = [{"indent": -1, "obj": root, "mode": "flow"}]
+
+    for raw in text.splitlines():
+        if not raw.strip() or raw.strip().startswith("#"):
+            continue
+        indent = len(raw) - len(raw.lstrip())
+        line = raw.strip()
+
+        # Skip block scalar body
+        if stack[-1]["mode"] == "block" and indent > stack[-1]["indent"]:
+            continue
+
+        while len(stack) > 1 and indent <= stack[-1]["indent"]:
+            stack.pop()
+
+        m = re.match(r"^([a-zA-Z_][a-zA-Z0-9_-]*)\s*:\s*(.*)$", line)
+        if not m:
+            continue
+        key, value = m.group(1), m.group(2)
+
+        # Strip inline `# comment` if not inside a quoted string
+        in_quote = None
+        cut_idx = len(value)
+        for i, c in enumerate(value):
+            if in_quote:
+                if c == in_quote:
+                    in_quote = None
+            elif c in ('"', "'"):
+                in_quote = c
+            elif c == "#":
+                cut_idx = i
+                break
+        value = value[:cut_idx].strip()
+
+        if value == "" or value == "|" or value == ">":
+            obj: dict = {}
+            stack[-1]["obj"][key] = obj
+            stack.append({"indent": indent, "obj": obj, "mode": "block" if value == "|" else "flow"})
+        else:
+            value = value.strip("\"'")
+            stack[-1]["obj"][key] = value
+
+    return root
+
+
+# ── Helpers ────────────────────────────────────────────────────────────────
+
+
+def read(path: str | Path) -> str:
+    full = ROOT / path
+    if not full.exists():
+        raise FileNotFoundError(f"missing: {path}")
+    return full.read_text(encoding="utf-8")
+
+
+def has_commit_tag(tag: str) -> bool:
+    try:
+        out = subprocess.check_output(
+            ["git", "log", "-1", "--format=%s"],
+            cwd=ROOT,
+            stderr=subprocess.DEVNULL,
+        )
+        return tag.encode() in out
+    except (subprocess.CalledProcessError, FileNotFoundError):
+        return False
+
+
+# ── Load pin table ─────────────────────────────────────────────────────────
+
+
+def main() -> int:
+    pin_path = ROOT / "docs" / "STACK_PIN.yaml"
+    if not pin_path.exists():
+        print("❌ docs/STACK_PIN.yaml not found", file=sys.stderr)
+        return 2
+    pin_doc = parse_yaml_simple(pin_path.read_text(encoding="utf-8"))
+    pin: dict[str, str] = pin_doc.get("stack_pin", {})
+
+    verbose = os.environ.get("VERBOSE") in ("1", "true", "yes")
+    bump_from_commit = has_commit_tag("[STACK BUMP]")
+    bump_from_env = os.environ.get("STACK_BUMP") == "1"
+    bump_ok = bump_from_commit or bump_from_env
+
+    if bump_from_commit:
+        print("[STACK_PIN] [STACK BUMP] tag present in HEAD commit — drift authorized")
+    elif bump_from_env:
+        print("[STACK_PIN] STACK_BUMP=1 — drift authorized (local override)")
+
+    drifts: list[dict[str, str | None]] = []
+
+    def check(label: str, expected: str | None, actual: str | None) -> None:
+        if expected is None:
+            return
+        if actual == expected:
+            if verbose:
+                print(f"  OK  {label}: {actual}")
+            return
+        drifts.append({"label": label, "expected": expected, "actual": actual})
+        print(f"  XX  {label}: expected={expected!r} actual={actual!r}")
+
+    # .nvmrc
+    try:
+        check("node (.nvmrc)", pin.get("node"), read(".nvmrc").strip())
+    except FileNotFoundError:
+        drifts.append({"label": "node", "expected": pin.get("node"), "actual": None})
+        print("  XX  node (.nvmrc): missing file")
+
+    # .python-version
+    try:
+        check("python (.python-version)", pin.get("python"), read(".python-version").strip())
+    except FileNotFoundError:
+        drifts.append({"label": "python", "expected": pin.get("python"), "actual": None})
+        print("  XX  python (.python-version): missing file")
+
+    # package.json
+    root_pkg = json.loads(read("package.json"))
+    check("pnpm (package.json packageManager)", f"pnpm@{pin.get('pnpm')}", root_pkg.get("packageManager"))
+    check("node (package.json engines.node)", pin.get("node"), root_pkg.get("engines", {}).get("node"))
+    check("pnpm (package.json engines.pnpm)", pin.get("pnpm"), root_pkg.get("engines", {}).get("pnpm"))
+
+    # apps/web/package.json
+    try:
+        web_pkg = json.loads(read("apps/web/package.json"))
+        check("next (apps/web/package.json)", pin.get("next"), web_pkg.get("dependencies", {}).get("next"))
+        check("react (apps/web/package.json)", pin.get("react"), web_pkg.get("dependencies", {}).get("react"))
+        check(
+            "react-dom (apps/web/package.json)",
+            pin.get("react_dom"),
+            web_pkg.get("dependencies", {}).get("react-dom"),
+        )
+        check(
+            "typescript (apps/web/package.json)",
+            pin.get("typescript"),
+            web_pkg.get("devDependencies", {}).get("typescript"),
+        )
+    except (FileNotFoundError, json.JSONDecodeError) as e:
+        print(f"  ⚠ apps/web/package.json: {e}", file=sys.stderr)
+
+    # apps/api/pyproject.toml
+    try:
+        api_toml = read("apps/api/pyproject.toml")
+        for pkg in ("sqlalchemy", "alembic", "asyncpg", "pyjwt", "supabase", "pydantic-settings"):
+            if pkg in pin:
+                m = re.search(rf'"{pkg}==([^"]+)"', api_toml)
+                check(f"{pkg} (apps/api/pyproject.toml)", pin[pkg], m.group(1) if m else None)
+        if "pydantic_core" in pin:
+            m = re.search(r'"pydantic-core==([^"]+)"', api_toml)
+            check("pydantic-core (apps/api/pyproject.toml)", pin["pydantic_core"], m.group(1) if m else None)
+        if "fastapi" in pin:
+            m = re.search(r'"fastapi==([^"]+)"', api_toml)
+            check("fastapi (apps/api/pyproject.toml [dev])", pin["fastapi"], m.group(1) if m else None)
+    except FileNotFoundError as e:
+        print(f"  ⚠ apps/api/pyproject.toml: {e}", file=sys.stderr)
+
+    # packages/cost_engine/pyproject.toml
+    try:
+        ce_toml = read("packages/cost_engine/pyproject.toml")
+        if "numpy" in pin:
+            m = re.search(r'"numpy==([^"]+)"', ce_toml)
+            check(
+                "numpy (packages/cost_engine/pyproject.toml [engine-math])",
+                pin["numpy"],
+                m.group(1) if m else None,
+            )
+        if "pytest" in pin:
+            m = re.search(r'"pytest==([^"]+)"', ce_toml)
+            check("pytest (packages/cost_engine/pyproject.toml [dev])", pin["pytest"], m.group(1) if m else None)
+    except FileNotFoundError as e:
+        print(f"  ⚠ packages/cost_engine/pyproject.toml: {e}", file=sys.stderr)
+
+    # root pyproject.toml
+    try:
+        root_toml = read("pyproject.toml")
+        for pkg, pin_key in (("import-linter", "import_linter"), ("pytest", "pytest"), ("ruff", "ruff")):
+            if pin_key in pin:
+                m = re.search(rf'"{pkg}==([^"]+)"', root_toml)
+                check(f"{pkg} (pyproject.toml dev)", pin[pin_key], m.group(1) if m else None)
+    except FileNotFoundError as e:
+        print(f"  ⚠ pyproject.toml: {e}", file=sys.stderr)
+
+    # Dockerfile
+    try:
+        dockerfile = read("Dockerfile")
+        from_lines = re.findall(r"^FROM\s+([^\s@]+)(@sha256:[a-f0-9]+)?", dockerfile, re.MULTILINE)
+        images = [img for img, _ in from_lines]
+        if "python_slim" in pin:
+            found = next((i for i in images if i.startswith("python:")), None)
+            check("python (Dockerfile base image)", f"python:{pin['python_slim']}"warning: in the working copy of 'scripts/regenerate_stack_pin.py', LF will be replaced by CRLF the next time Git touches it
, found)
+        if "node_alpine" in pin:
+            found = next((i for i in images if i.startswith("node:")), None)
+            check("node (Dockerfile base image)", f"node:{pin['node_alpine']}", found)
+        if "nginx_alpine" in pin:
+            found = next((i for i in images if i.startswith("nginx:")), None)
+            check("nginx (Dockerfile base image)", f"nginx:{pin['nginx_alpine']}", found)
+    except FileNotFoundError as e:
+        print(f"  ⚠ Dockerfile: {e}", file=sys.stderr)
+
+    # ── Verdict ──
+    if not drifts:
+        print(f"[STACK_PIN] OK all {len(pin)} pins match")
+        return 0
+
+    if bump_ok:
+        print(f"[STACK_PIN] WARN {len(drifts)} drift(s) detected but [STACK BUMP] authorized -- pass:")
+        for d in drifts:
+            print(f"  - {d['label']}: {d['expected']} -> {d['actual']}")
+        return 0
+
+    print(f"[STACK_PIN] FAIL {len(drifts)} drift(s) detected:", file=sys.stderr)
+    for d in drifts:
+        print(f"  - {d['label']}: expected={d['expected']} actual={d['actual']}", file=sys.stderr)
+    print("[STACK_PIN] Use commit tag [STACK BUMP] to authorize this drift.", file=sys.stderr)
+    return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
