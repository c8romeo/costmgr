+#!/usr/bin/env bash
+# scripts/bump_stack_pin.sh — Bump a single stack-pin version with auto [STACK BUMP] tag.
+#
+# Story 0.3 / AD-14 enforcement helper.
+#
+# Usage:
+#   ./scripts/bump_stack_pin.sh <package> <new_version>
+#   ./scripts/bump_stack_pin.sh next 16.2.11
+#   ./scripts/bump_stack_pin.sh python 3.12.1
+#
+# Behavior:
+#   1. Updates docs/STACK_PIN.yaml (canonical source).
+#   2. Updates the relevant manifest(s) where <package> is declared:
+#        next / react / react-dom / typescript / tailwind -> apps/web/package.json
+#        fastapi / pydantic / pydantic-core / sqlalchemy / alembic / asyncpg /
+#          pyjwt / supabase / pydantic-settings -> apps/api/pyproject.toml
+#        numpy / pytest / ruff -> packages/cost_engine/pyproject.toml
+#        import-linter / pytest / ruff -> root pyproject.toml [dependency-groups].dev
+#        python (runtime) -> Dockerfile + .python-version
+#        node (runtime) -> Dockerfile + .nvmrc
+#        pnpm / uv -> package.json engines / .github/workflows/ci.yml
+#   3. Prints the planned diff and asks for confirmation.
+#   4. Commits with message `[STACK BUMP] bump <package> <old> -> <new>`.
+#
+# Notes:
+#   - Use `git push` separately. The CI guard will accept the bump because
+#     the tag is present.
+#   - The script does NOT run pnpm install / uv lock automatically — those
+#     should be done by the engineer after reviewing the diff.
+
+set -euo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "Usage: $0 <package> <new_version>" >&2
+  echo "Example: $0 next 16.2.11" >&2
+  exit 2
+fi
+
+PKG="$1"
+VER="$2"
+
+REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
+PIN_FILE="$REPO_ROOT/docs/STACK_PIN.yaml"
+
+if [[ ! -f "$PIN_FILE" ]]; then
+  echo "STACK_PIN.yaml not found at $PIN_FILE" >&2
+  exit 1
+fi
+
+# Read current version from yaml (very naive — works for `key: value`)
+CURRENT=$(grep -E "^\s*${PKG}:" "$PIN_FILE" | head -1 | sed -E "s/^\s*${PKG}:\s*['\"]?([^'\"]+)['\"]?.*$/\1/")
+
+if [[ -z "$CURRENT" ]]; then
+  echo "Package '$PKG' not found in $PIN_FILE" >&2
+  echo "Add it first via Edit, then re-run." >&2
+  exit 1
+fi
+
+if [[ "$CURRENT" == "$VER" ]]; then
+  echo "Package '$PKG' is already at version '$VER' — no bump needed." >&2
+warning: in the working copy of 'scripts/check_stack_pin.mjs', LF will be replaced by CRLF the next time Git touches it
  exit 0
+fi
+
+echo "────────────────────────────────────────────────────────"
+echo "Stack pin bump"
+echo "  package: $PKG"
+echo "  current: $CURRENT"
+echo "  target:  $VER"
+echo "────────────────────────────────────────────────────────"
+
+# Plan the edits — list the files we expect to touch.
+PLAN=()
+
+case "$PKG" in
+  node|next|react|react-dom|react_dom|typescript|tailwind)
+    PLAN+=("apps/web/package.json")
+    [[ "$PKG" == "node" ]] && PLAN+=(".nvmrc" "Dockerfile")
+    [[ "$PKG" == "next" ]] && PLAN+=("pnpm-lock.yaml")
+    ;;
+  python|python_slim)
+    PLAN+=(".python-version" "Dockerfile")
+    ;;
+  pnpm)
+    PLAN+=("package.json")
+    ;;
+  uv)
+    PLAN+=(".github/workflows/ci.yml")
+    ;;
+  fastapi|pydantic|pydantic_core|pydantic-core|sqlalchemy|alembic|asyncpg|pyjwt|supabase|pydantic-settings|uvicorn|httpx)
+    PLAN+=("apps/api/pyproject.toml")
+    ;;
+  numpy|pytest|ruff|import_linter|import-linter)
+    PLAN+=("packages/cost_engine/pyproject.toml" "pyproject.toml")
+    ;;
+  postgresql|nginx_alpine|node_alpine|python_slim)
+    PLAN+=("Dockerfile")
+    ;;
+  *)
+    echo "Unknown package '$PKG' — bump only STACK_PIN.yaml manually." >&2
+    PLAN=("$PIN_FILE")
+    ;;
+esac
+
+echo "Files to update (planned):"
+printf '  - %s\n' "${PLAN[@]}"
+echo
+echo "This script does NOT auto-edit manifest files — it updates STACK_PIN.yaml"
+echo "and creates a commit. You are responsible for editing the manifests in"
+echo "the same commit (or running pnpm install / uv lock afterwards)."
+echo
+read -r -p "Proceed? [y/N] " ans
+if [[ "$ans" != "y" && "$ans" != "Y" ]]; then
+  echo "Aborted." >&2
+  exit 1
+fi
+
+# Update STACK_PIN.yaml — replace the value on the matching key line.
+# Handles both `key: value` and `key: "value"` and preserves comments.
+python3 - <<PY
+import re, sys
+path = "$PIN_FILE"
+text = open(path, encoding="utf-8").read()
+new = re.sub(
+    rf"^(\s*${PKG}\s*:\s*)['\"]?[^'\"]*['\"]?",
+    rf"\g<1>{VER!r}".replace("'", '"'),
+    text,
+    count=1,
+    flags=re.MULTILINE,
+)
+if new == text:
+    print(f"WARN: no substitution made for key '{PKG}' in {path}", file=sys.stderr)
+else:
+    open(path, "w", encoding="utf-8").write(new)
+    print(f"updated {path}")
+PY
+
+git add "$PIN_FILE"
+git commit -m "[STACK BUMP] bump ${PKG} ${CURRENT} -> ${VER}"
+
+echo
+echo "────────────────────────────────────────────────────────"
+echo "Done. Next steps:"
+echo "  1. Edit the planned manifest files (see list above):"
+printf '     - %s\n' "${PLAN[@]}" | grep -v "STACK_PIN.yaml" || true
+echo "  2. Run 'pnpm install --frozen-lockfile=false' (npm) or 'uv lock' (pip)."
+echo "  3. Verify locally:"
+echo "       pnpm dep:check"
+echo "       uv run python scripts/check_stack_pin.py"
+echo "  4. Run the V8 regression gate:"
+echo "       uv run pytest packages/cost_engine/tests/regression_v8 -v"
+echo "  5. Push the branch and open a PR."
+echo "────────────────────────────────────────────────────────"
\ No newline at end of file
