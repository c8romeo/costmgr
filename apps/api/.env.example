# apps/api/.env.example — env surface for Story 0.2
# Copy to .env and fill in real values for local dev.
# Per AD-9: region pinned to ap-northeast-2 (Seoul).
# Per AD-3 / AD-10: tenant_id and role are read from JWT app_metadata, never from request body.

# ── Service identity ──────────────────────────────────────
SERVICE_NAME=costmgr-api
SERVICE_VERSION=0.1.0
ENVIRONMENT=development
REGION=ap-northeast-2

# ── Supabase (Story 0.2 wires; deferred to pilot — leave empty for local-Postgres dev) ──
# These point at a real Supabase project in ap-northeast-2 (Seoul).
# Fill in after pilot provisioning. Until then, leave as None and use a local Postgres.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-side only — never expose to client
SUPABASE_JWT_SECRET=              # HS256 secret used to sign Supabase auth JWTs
# JWT_LEEWAY_SEC=30                          # default 30 sec clock-skew tolerance

# ── Database (Story 0.2 wires) ────────────────────────────
# Direct connection (port 5432), used by Alembic + the async engine.
# Format: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres  # sync (Alembic env)

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO

# ── CORS (cj-319 A-0 wire — Track A F2 정직 회복) ──
# `apps/api/main.py` 의 CORSMiddleware allowlist. comma-separated.
# 브라우저가 Vercel(web) origin 에서 이 API 로 직접 호출하는 구조 전제
# (`vercel.json` CSP connect-src https://*.railway.app 와 1:1 계약).
# 미설정 시 http://localhost:3000 만 허용 = fail-closed (wildcard 금지).
# Production 예: CORS_ORIGINS=https://costmgr-pilot.vercel.app
CORS_ORIGINS=

# ── Email delivery (cj-305b Resend migration 결정 wire 반영) ──────────────
# Story 30.3 Email delivery — cj-305b OQ-EPIC30+-2 결정 wire v2 = Resend
# transactional email HTTP API. cj-299 의 Postmark 결정 wire → cj-305b 의 Resend
# 으로 migration 결정 wire 진입 (Postmark 의 public-domain-email 가입 차단 이슈).
# Production REQUIRES RESEND_API_KEY; 부재 시 LoggingProvider fallback (stdout 로그만
# 출력, 실제 발송 안 됨). Priority: RESEND_API_KEY → SMTP_HOST → LoggingProvider (dev).
# Resend Free: 3000 emails/month + 100/day, https://resend.com
# Signup: https://resend.com/signup (GitHub OAuth or email, public email 허용)
# Token capture: Dashboard → API Keys → Create API Key
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ── Scheduled reports (cj-300 wire sprint 결정 wire 반영) ──────────────
# Story 30.4 Scheduled reports — cj-300 OQ-EPIC30+-3 결정 wire = APScheduler.
# KST timezone mandatory for cron scheduling (Railway 기본 UTC → 24h 오프셋 방지).
# Exponential backoff: 1min → 5min → 30min, 3 retries total.
TZ=Asia/Seoul
RETRY_BACKOFF_MINUTES=1,5,30
