# ── API base URL ──────────────────────────────────────────
# FastAPI 로컬 서버 주소. mvp_local_db.py 가 같은 머신에서 listen.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Customer support ──────────────────────────────────────
NEXT_PUBLIC_SUPPORT_EMAIL=support@bizup.kr

# ── Sentry (빈 값 = disabled) ─────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# ── MVP local-dev bypass (cj-style N+16, D-Day 2026-09-14 KST) ────
# Backend (FastAPI) has its own MVP_DEV_BYPASS env. Mirroring it here so
# frontend layout-level auth gates (which independently check
# sb-access-token cookie) skip the redirect to /login when the backend
# dev bypass is active. Both must be true for the bypass to function.
# Production safety: leave unset or "false" in any non-local environment.
NEXT_PUBLIC_MVP_DEV_BYPASS=true
