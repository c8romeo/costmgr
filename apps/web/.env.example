# apps/web/.env.example — env surface for Next.js web (1st release launch).
# Copy to .env.local and fill in real values for local dev.

# ── Supabase (Phase 3-1 wire `d3e7454` 정합) ───────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Customer support (1st release launch — F18.4 AC #4.2) ─────
# Mirrored to apps/api/.env.example. Both must agree.
NEXT_PUBLIC_SUPPORT_EMAIL=support@bizup.kr

# ── Sentry (1st release launch — F18.5 AC #5.3) ───────────
# @sentry/nextjs ^8.x is required (apps/web/package.json line 31).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=          # server-side only, used by `sentry-cli` for source map upload