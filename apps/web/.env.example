# apps/web/.env.example — env surface for Next.js web (1st release launch).
# Copy to .env.local and fill in real values for local dev.

# ── Supabase (Phase 3-1 wire `d3e7454` 정합) ───────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── API base URL (cj-319 A-0 wire — Track A F3 정직 회복) ───────────
# `apps/web/lib/**` 의 apiBaseUrl() 이 읽는 유일한 API origin.
# 미설정 시 코드 기본값 `http://localhost:8765` 로 폴백 → **production 에서
# 미설정이면 파일럿 프론트엔드가 localhost 를 호출**한다.
# `docs/deployment-account-setup.md` §4.5 Vercel env var 표에는 존재했으나
# 본 .env.example 에 누락되어 있었음 (cj-318 Track A 진입 시 정직 인정).
# Production 값 = Railway 서비스 도메인 (예: https://<service>.up.railway.app).
# Railway 측 `CORS_ORIGINS` 에 Vercel origin 이 등록되어 있어야 실제로 통한다.
NEXT_PUBLIC_API_URL=http://localhost:8765

# ── Customer support (1st release launch — F18.4 AC #4.2) ─────
# Mirrored to apps/api/.env.example. Both must agree.
NEXT_PUBLIC_SUPPORT_EMAIL=support@bizup.kr

# ── Sentry (1st release launch — F18.5 AC #5.3) ───────────
# @sentry/nextjs ^8.x is required (apps/web/package.json line 31).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=          # server-side only, used by `sentry-cli` for source map upload