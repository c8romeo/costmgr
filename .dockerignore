# costmgr .dockerignore — keep build context small
node_modules/
.next/
out/
dist/
build/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets & env
.env
.env.*
*.pem
*.key
secrets/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Tests + dev fixtures (not needed in image)
tests/
.claude/
_bmad/
_bmad-output/

# Git + cache
.git/
.gitignore
*.md
LICENSE

# Local artefacts
*.log
coverage/
htmlcov/
.cache/

# CI / deploy
.github/
Dockerfile
.dockerignore