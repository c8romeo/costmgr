# ─────────────────────────────────────────────────────────────────
# costmgr .gitignore
# ─────────────────────────────────────────────────────────────────

# Node / Next.js
node_modules/
.next/
out/
dist/
build/
.turbo/
.npm/
.pnpm-store/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# 환경 변수 / 시크릿
.env
.env.local
.env.*.local
.env.development
.env.production
*.pem
*.key
secrets/

# OS / 에디터
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
*.iml

# 캐시 / 테스트 결과
.cache/
.parcel-cache/
coverage/
*.lcov

# BMad — install-managed skill cache (재설치 시 재생성)
.claude/skills/

# BMad 산출물 — 산출은 추적하되 검증용 HTML/리뷰 산출물은 제외
# (planning-artifacts 핵심 문서는 추적 대상)
_bmad-output/planning-artifacts/validation-report.html

# BMad 메모로그 (대화 trace, 일시적)
_bmad-output/planning-artifacts/.memlog.md
_bmad-output/planning-artifacts/architecture/*/.memlog.md

# 대용량 문서(필요 시 해제)
# *.zip
# *.tar.gz
